# Copy only into Dokploy's private environment/secret store. Never commit values.
# Generate URL-safe secrets, for example: openssl rand -hex 32

# REQUIRED: database service. Keep this password URL-safe because Compose also
# places it in DATABASE_URL. For a Dokploy-managed external PostgreSQL service,
# set DATABASE_URL explicitly instead.
POSTGRES_DB=voxera
POSTGRES_USER=voxera
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
# DATABASE_URL=postgresql://voxera:URL_SAFE_PASSWORD@db:5432/voxera

# REQUIRED: public/runtime trust boundary.
VOXERA_PUBLIC_URL=https://pilot.example.com
VOXERA_OPERATOR_EMAILS=operator@example.com
VOXERA_SECRET_KEY=REPLACE_WITH_64_HEX_CHARACTERS
VOXERA_MANAGE_SECRET=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
VOXERA_DEMO_SECRET=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
VOXERA_TRUST_PROXY_HOPS=1
VOXERA_BUILD_ID=git-sha-or-release-id

# Pilot media. Leave REQUIRE_MEDIA=0 until a live media provider path has passed
# acceptance. Gather-mode Twilio calls still work without raw audio streaming.
VOXERA_MEDIA_SECRET=
VOXERA_REQUIRE_MEDIA=0

# Phase 1 clinical/document foundation. Keep approval at 0 and the clinical mode
# disabled/synthetic until the independent gates in
# docs/phase-1-implementation-status.md are complete. The document key must be a
# separately managed 32-byte value and must not be stored only on this VPS.
VOXERA_CLINICAL_DATA_APPROVED=0
VOXERA_DOCUMENT_MASTER_KEY=
VOXERA_DOCUMENT_MAX_BYTES=26214400

# Filesystem storage is synthetic/test only. For eventual live readiness select
# s3 and provide a dedicated private S3-compatible/R2 bucket; these credentials
# are distinct from the optional PostgreSQL-backup R2 credentials below.
VOXERA_BLOB_BACKEND=filesystem
VOXERA_BLOB_ROOT=/app/data/clinical-blobs
VOXERA_S3_ENDPOINT=
VOXERA_S3_REGION=auto
VOXERA_S3_BUCKET=
VOXERA_S3_ACCESS_KEY_ID=
VOXERA_S3_SECRET_ACCESS_KEY=

# Configure the target host's real malware scanner. Missing/error scanners fail
# closed. Never use /bin/true outside local contract tests.
VOXERA_MALWARE_SCAN_COMMAND=
VOXERA_MALWARE_SCAN_ARGS_JSON=["--no-summary","{file}"]
VOXERA_MALWARE_SCAN_TIMEOUT_MS=120000

# Twilio voice + SMS. Configure both or neither.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Email — the selected provider is Resend. Verify the sending domain first, then
# set PROVIDER=resend and API_BASE=https://api.resend.com together with the key
# and From identity. Leave all four blank until live acceptance is ready.
VOXERA_EMAIL_PROVIDER=
VOXERA_EMAIL_API_BASE=
VOXERA_EMAIL_API_KEY=
VOXERA_EMAIL_FROM=
# Create a Resend webhook for https://your-host/api/webhooks/resend and subscribe
# to sent, delivered, delayed, failed, bounced, complained and suppressed events.
RESEND_WEBHOOK_SECRET=

# Stripe. Configure both or neither. Webhook URL:
# https://pilot.example.com/api/payments/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional model providers. Turn REQUIRE_AI on only after at least one live key
# passes the provider acceptance checklist.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
# Live carrier STT currently requires Deepgram streaming. The listed TTS keys are
# optional alternatives. Keep REQUIRE_MEDIA=0 until a real call has proved STT,
# TTS, consent wording, latency, fallback and handoff.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
VOXERA_REQUIRE_AI=0

# Operations. This host path must itself be copied off the VPS.
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=21600
BACKUP_KEEP=56
VOXERA_SCHEDULER=1

# OPTIONAL: encrypted off-box Cloudflare R2 copy. These are used only with
# deploy/docker-compose.r2.yml. Use a dedicated private bucket and restricted
# object read/write credentials. R2_CRYPT_PASSWORD is the output of
# `rclone obscure`, not the plain passphrase; retain it in a separate password
# manager because an R2 copy cannot be restored without it.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PREFIX=voxera-postgres
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_CRYPT_PASSWORD=
R2_CRYPT_PASSWORD2=
R2_SYNC_INTERVAL_SECONDS=900
R2_MIN_AGE=2m

# Runtime budgets for the initial one-replica 4 GB VPS profile. Re-measure before
# changing them; image builds need more headroom than the running app.
VOXERA_MEMORY_LIMIT=1536m
VOXERA_CPUS=2.0
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPUS=1.5
BACKUP_MEMORY_LIMIT=768m
BACKUP_CPUS=1.0

# Local host binding; Dokploy/Traefik reaches app:3000 on the Compose network.
VOXERA_BIND_ADDRESS=127.0.0.1
VOXERA_PORT=3000
