# Voxera — deployment environment
#
# Copy to `.env` and fill in what you have:
#
#   cp .env.example .env
#
# Nothing here is required to boot. With every value blank the app runs, serves
# the marketing site and the dashboard, and the dashboard says in words what is
# missing — a reminder with no carrier is refused at the desk, not silently
# dropped. The blank lines are the honest default: no key, no provider.

# ---- the store ---------------------------------------------------------------

# Safe local default. Dokploy Compose overrides this to PostgreSQL; use
# deploy/dokploy.env.example for production values. JSON is recovery-only.
VOXERA_STORE=sqlite
DATABASE_URL=

# The container uses /app/data; a checkout uses its own data directory.
VOXERA_DATA_DIR=./data

# Local development stays non-strict. Staging/production must use strict=1 and
# the dokploy profile (the Compose file sets both).
VOXERA_STRICT_CONFIG=0
VOXERA_PRODUCTION_PROFILE=generic

# How long the audit trail keeps individual rows. Older rows are folded into
# per-month counts in `auditRollups` before being deleted, so the record of what
# happened survives but the collection stops growing without a ceiling.
VOXERA_AUDIT_RETENTION_DAYS=90

# Logging: `debug | info | warn | error`, and whether to log one line per request.
# Set VOXERA_LOG_REQUESTS=0 when a proxy already logs traffic.
VOXERA_LOG_LEVEL=info
VOXERA_LOG_REQUESTS=1
VOXERA_BUILD_ID=local

# Compose backup cadence/retention. BACKUP_DIR must be copied off the VPS.
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=21600
BACKUP_KEEP=56

# ---- seeding -----------------------------------------------------------------

# Whether a brand-new workspace arrives with the demo's fabricated history (three
# assistants, two numbers and 168 scripted calls) so the dashboard shows what the
# product does. The default is on in development and **off in production** — set 1
# to force it on, 0 to force it off. Either way every workspace gets its tools,
# assistants, services, rotas and templates; the flag only decides whether the
# diary is prefilled with made-up calls.
VOXERA_SEED_DEMO=0

# ---- clinical data and documents --------------------------------------------

# Final operator switch for real patient data. Keep 0 until every readiness gate
# in docs/phase-1-implementation-status.md has independent, target-environment
# evidence. Setting this to 1 does not bypass the other fail-closed gates.
VOXERA_CLINICAL_DATA_APPROVED=0

# Separate 32-byte key for document envelope encryption (64 hex characters or
# base64). Do not reuse VOXERA_SECRET_KEY; keep it outside database/blob/backup
# volumes and retain recovery material under controlled custody.
VOXERA_DOCUMENT_MASTER_KEY=
VOXERA_DOCUMENT_MAX_BYTES=26214400

# `filesystem` is local development/synthetic-test only. Clinical live readiness
# requires `s3` and complete S3-compatible credentials. Cloudflare R2 uses its
# S3 endpoint and typically the `auto` region. Object keys contain random IDs.
VOXERA_BLOB_BACKEND=filesystem
VOXERA_BLOB_ROOT=./data/clinical-blobs
VOXERA_S3_ENDPOINT=
VOXERA_S3_REGION=auto
VOXERA_S3_BUCKET=
VOXERA_S3_ACCESS_KEY_ID=
VOXERA_S3_SECRET_ACCESS_KEY=

# The scanner receives a temporary plaintext path through `{file}` in the JSON
# argument array. Missing/error/timeout scanners leave bytes quarantined. `/bin/true`
# is suitable only for contract tests and is not malware protection.
VOXERA_MALWARE_SCAN_COMMAND=
VOXERA_MALWARE_SCAN_ARGS_JSON=["--no-summary","{file}"]
VOXERA_MALWARE_SCAN_TIMEOUT_MS=120000

# ---- the app -----------------------------------------------------------------

# Where the app can be reached from outside. Used to build the links that go out
# in texts and emails (client links, claim links, payment links). If it is wrong,
# every link in a message is wrong.
VOXERA_PUBLIC_URL=http://localhost:3000

# Local requests are direct. Dokploy Compose enables one trusted Traefik hop;
# never enable this merely because a client can send X-Forwarded-For.
VOXERA_TRUST_PROXY=0
VOXERA_TRUST_PROXY_HOPS=1

# Optional whitespace-separated HTTPS parents allowed to frame the app. Empty is
# safest and defaults to same-origin only.
VOXERA_FRAME_ANCESTORS=

# The key that wraps provider secrets at rest (carrier auth tokens, API keys),
# and the default source for the link and demo secrets below. Set it in any
# deployment that holds real credentials and keep it out of the volume: without
# it a key file is generated beside the store, so a copy of the volume is a copy
# of everything needed to decrypt what is in it.
VOXERA_SECRET_KEY=

# The reminder lead time in minutes (default 1440 = a day before).
VOXERA_REMINDER_LEAD_MINUTES=1440

# Set to 0 to stop the scheduler: no reminders, no follow-ups, no campaign
# dialling, no queued sends. Useful when a copy of the demo should sit still.
VOXERA_SCHEDULER=1

# ---- telephony (Twilio) -------------------------------------------------------

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Only for a stub or a proxy: points the carrier client somewhere other than
# api.twilio.com. Leave blank in production.
TWILIO_API_BASE=

# Longest a single media-stream call may run, in minutes (default 60).
VOXERA_MAX_CALL_MINUTES=60

# ---- the media path (raw audio) ----------------------------------------------

# The secret that signs media-stream tokens. Unset, raw-audio calls are refused
# and numbers answer with carrier-side speech recognition instead — the app says
# so on its own startup line.
VOXERA_MEDIA_SECRET=

# Signing without a carrier: audio is accepted and discarded, so the socket path
# can be exercised end to end.
VOXERA_MEDIA_SIMULATE=0

# Local verification only: exposes /api/webhook-echo. Strict production refuses
# to start when this is enabled.
VOXERA_ENABLE_TEST_ENDPOINTS=0

# Make strict startup require the media and model paths selected for this release.
VOXERA_REQUIRE_MEDIA=0
VOXERA_REQUIRE_AI=0

# ---- speech and models -------------------------------------------------------
# Each is optional. Live carrier STT requires Deepgram; model and TTS selection
# remains unavailable until the matching target account/key is verified.

DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# Claude, through the Anthropic API. `ANTHROPIC_API_BASE` is for a stub only.
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=

# ---- platform operator --------------------------------------------------------

# Comma-separated emails of whoever runs this deployment. Only these emails
# get platform-wide admin, sales leads and growth access. Empty = nobody has
# operator access, including on self-hosted installations; configure it
# explicitly before using the console.
VOXERA_OPERATOR_EMAILS=

# ---- email and SMS delivery --------------------------------------------------

# Select `resend` for the production pilot or `relay` for a compatible generic
# HTTP relay. Direct Resend uses exactly https://api.resend.com; the adapter
# translates internal metadata to provider-safe tags.
VOXERA_EMAIL_PROVIDER=
VOXERA_EMAIL_API_BASE=
VOXERA_EMAIL_API_KEY=
VOXERA_EMAIL_FROM=Voxera <no-reply@example.com>

# Required with VOXERA_EMAIL_PROVIDER=resend. Create the signed webhook at
# /api/webhooks/resend and keep this whsec_ value outside source control.
RESEND_WEBHOOK_SECRET=

# ---- payments ----------------------------------------------------------------

# Real Stripe settlement. Blank, the money screens run against the simulated
# processor and say so — invoices, payments and receipts are still real records,
# but no card is charged. Set this (or connect Stripe inside the workspace) before
# anyone relies on a payment link for income.
STRIPE_SECRET_KEY=

# Verifies the `stripe-signature` header on the webhook. Without it the endpoint
# refuses every event with a 400, so a real deployment must set it.
STRIPE_WEBHOOK_SECRET=

# ---- link and demo signing ---------------------------------------------------

# Signs the client's own link (`/m/<token>`) and a freed-slot offer. Anyone who
# knows this can mint a working link for any appointment id, so it is not
# optional on a public deployment. If unset, the app falls back to
# VOXERA_MEDIA_SECRET, then to a key derived from VOXERA_SECRET_KEY — and only
# then, in production, to a per-process random value that invalidates every
# outstanding link on restart.
VOXERA_MANAGE_SECRET=

# Signs the homepage demo's turn tokens. Unset in production, tokens are signed
# with a per-process random key (never the old public fallback), so they work for
# one process and are not forgeable.
VOXERA_DEMO_SECRET=

# ---- outbound safety ---------------------------------------------------------

# Refuse calls and messages to private and loopback addresses. Leave at the
# default in anything reachable from the internet; set 1 only when pointing the
# app at a local stub.
VOXERA_ALLOW_PRIVATE_OUTBOUND=0

# Accept unsigned telephony callbacks only in a non-production local-stub
# process. Production ignores this switch and always fails closed.
VOXERA_ALLOW_UNSIGNED_TELEPHONY=0
